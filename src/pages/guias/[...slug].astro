---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { LOJAS, SITE } from '../../consts';

export async function getStaticPaths() {
  const guias = await getCollection('guias');
  return guias.map((guia) => ({
    params: { slug: guia.id },
    props: { guia },
  }));
}

type Props = { guia: CollectionEntry<'guias'> };

const { guia } = Astro.props;
const { Content } = await render(guia);

const todos = (await getCollection('guias')).sort(
  (a, b) => b.data.data.valueOf() - a.data.data.valueOf()
);
const relacionados = todos.filter((g) => g.id !== guia.id).slice(0, 2);

const fmt = (d: Date) =>
  d.toLocaleDateString('pt-BR', { day: '2-digit', month: 'long', year: 'numeric' });

const imagem = guia.data.imagem ?? SITE.ogImage;
const urlAbs = new URL(`/guias/${guia.id}/`, Astro.site).href;

const schema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: guia.data.titulo,
  description: guia.data.descricao,
  image: new URL(imagem, Astro.site).href,
  datePublished: guia.data.data.toISOString(),
  dateModified: guia.data.data.toISOString(),
  author: { '@type': 'Organization', name: 'Bellatotti' },
  publisher: {
    '@type': 'Organization',
    name: 'Bellatotti',
    logo: {
      '@type': 'ImageObject',
      url: 'https://www.bellatotti.com.br/lissafiore.jpg',
    },
  },
  mainEntityOfPage: { '@type': 'WebPage', '@id': urlAbs },
};

const breadcrumb = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Início', item: SITE.url + '/' },
    { '@type': 'ListItem', position: 2, name: 'Guias', item: SITE.url + '/guias/' },
    { '@type': 'ListItem', position: 3, name: guia.data.titulo, item: urlAbs },
  ],
};
---

<Base
  titulo={`${guia.data.titulo} | Bellatotti`}
  descricao={guia.data.descricao}
  imagem={imagem}
  tipo="article"
>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(schema)} />
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(breadcrumb)} />

  <article class="artigo">
    <nav class="migalhas" aria-label="Navegação estrutural">
      <a href="/">Início</a>
      <span>/</span>
      <a href="/guias/">Guias</a>
    </nav>

    <header class="artigo-topo">
      <span class="artigo-categoria">{guia.data.categoria}</span>
      <h1>{guia.data.titulo}</h1>
      <p class="artigo-resumo">{guia.data.descricao}</p>
      <time class="artigo-data" datetime={guia.data.data.toISOString()}>
        {fmt(guia.data.data)}
      </time>
    </header>

    <div class="prosa">
      <Content />
    </div>

    <aside class="cta-compra">
      <span class="section-tag">Coleção Bellatotti</span>
      <h2>Pronta para escolher o seu?</h2>
      <p>
        Saltos femininos premium com conforto real e acabamento de luxo.
        Envio rápido para todo o Brasil.
      </p>
      <div class="cta-botoes">
        <a class="btn-cta-principal" href={LOJAS.shopee} target="_blank" rel="noopener">
          <i class="fas fa-shopping-bag" style="font-size:12px;"></i>
          Ver na Shopee
        </a>
        <a class="btn-cta-zap" href={LOJAS.whatsapp} target="_blank" rel="noopener">
          <i class="fab fa-whatsapp" style="font-size:13px;"></i>
          Falar no WhatsApp
        </a>
      </div>
    </aside>

    {relacionados.length > 0 && (
      <section class="relacionados">
        <h2 class="relacionados-titulo">Continue lendo</h2>
        <div class="relacionados-grid">
          {relacionados.map((g) => (
            <a href={`/guias/${g.id}/`} class="relacionado-card">
              <span class="guia-tag">{g.data.categoria}</span>
              <h3>{g.data.titulo}</h3>
              <span class="guia-link">Ler guia <i class="fas fa-arrow-right"></i></span>
            </a>
          ))}
        </div>
      </section>
    )}
  </article>
</Base>

<style>
  .artigo {
    max-width: 760px;
    margin: 0 auto;
    padding: 140px 40px 100px;
  }

  .migalhas {
    display: flex;
    gap: 10px;
    align-items: center;
    font-size: 11px;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: var(--text-muted);
    margin-bottom: 40px;
  }

  .migalhas a {
    color: var(--text-muted);
    text-decoration: none;
    transition: var(--transition);
  }

  .migalhas a:hover { color: var(--gold-dark); }

  .artigo-topo {
    padding-bottom: 40px;
    border-bottom: 1px solid var(--cream);
    margin-bottom: 48px;
  }

  .artigo-categoria {
    font-size: 10px;
    letter-spacing: 4px;
    text-transform: uppercase;
    color: var(--gold-dark);
    font-weight: 500;
    display: block;
    margin-bottom: 20px;
  }

  .artigo-topo h1 {
    font-family: 'Cormorant Garamond', serif;
    font-weight: 300;
    font-size: clamp(32px, 5vw, 52px);
    line-height: 1.15;
    letter-spacing: 0.5px;
    color: var(--black);
    margin-bottom: 20px;
  }

  .artigo-resumo {
    font-size: 17px;
    font-weight: 300;
    line-height: 1.8;
    color: #555;
    letter-spacing: 0.2px;
    margin-bottom: 24px;
  }

  .artigo-data {
    font-size: 11px;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: var(--text-muted);
  }

  /* ─── PROSA ─── */
  .prosa {
    font-size: 16px;
    line-height: 1.85;
    color: #2a2a2a;
    font-weight: 300;
    letter-spacing: 0.2px;
  }

  .prosa :global(h2) {
    font-family: 'Cormorant Garamond', serif;
    font-weight: 400;
    font-size: 32px;
    line-height: 1.25;
    color: var(--black);
    margin: 56px 0 18px;
    letter-spacing: 0.5px;
  }

  .prosa :global(h3) {
    font-size: 14px;
    font-weight: 600;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: var(--gold-dark);
    margin: 40px 0 14px;
  }

  .prosa :global(p) { margin-bottom: 22px; }

  .prosa :global(a) {
    color: var(--black);
    text-decoration: underline;
    text-decoration-color: var(--gold);
    text-underline-offset: 4px;
    text-decoration-thickness: 1px;
    transition: var(--transition);
  }

  .prosa :global(a:hover) {
    color: var(--gold-dark);
    text-decoration-color: var(--gold-dark);
  }

  .prosa :global(strong) { font-weight: 600; color: var(--black); }

  .prosa :global(ul),
  .prosa :global(ol) {
    margin: 0 0 22px 22px;
    padding-left: 8px;
  }

  .prosa :global(li) { margin-bottom: 10px; }
  .prosa :global(li::marker) { color: var(--gold); }

  .prosa :global(blockquote) {
    border-left: 2px solid var(--gold);
    padding: 4px 0 4px 24px;
    margin: 32px 0;
    font-family: 'Cormorant Garamond', serif;
    font-style: italic;
    font-size: 21px;
    line-height: 1.6;
    color: #444;
  }

  .prosa :global(blockquote p) { margin-bottom: 0; }

  .prosa :global(table) {
    width: 100%;
    border-collapse: collapse;
    margin: 32px 0;
    font-size: 14px;
  }

  .prosa :global(th) {
    background: var(--black);
    color: var(--gold);
    font-size: 11px;
    letter-spacing: 2px;
    text-transform: uppercase;
    font-weight: 600;
    padding: 14px 16px;
    text-align: left;
  }

  .prosa :global(td) {
    padding: 14px 16px;
    border-bottom: 1px solid var(--cream);
    background: #fff;
  }

  .prosa :global(img) {
    width: 100%;
    height: auto;
    display: block;
    margin: 32px 0;
  }

  .prosa :global(hr) {
    border: none;
    height: 1px;
    background: var(--cream);
    margin: 48px 0;
  }

  .prosa :global(.tabela-scroll) { overflow-x: auto; }

  /* ─── CTA ─── */
  .cta-compra {
    background: var(--black);
    padding: 56px 40px;
    text-align: center;
    margin: 72px 0 0;
  }

  .cta-compra h2 {
    font-family: 'Cormorant Garamond', serif;
    font-weight: 300;
    font-size: clamp(26px, 3.5vw, 38px);
    color: #fff;
    letter-spacing: 0.5px;
    margin-bottom: 16px;
  }

  .cta-compra p {
    font-size: 14px;
    font-weight: 300;
    line-height: 1.8;
    color: rgba(255,255,255,0.6);
    max-width: 420px;
    margin: 0 auto 32px;
  }

  .cta-botoes {
    display: flex;
    gap: 14px;
    justify-content: center;
    flex-wrap: wrap;
  }

  .btn-cta-principal, .btn-cta-zap {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    padding: 14px 28px;
    text-decoration: none;
    font-size: 11px;
    letter-spacing: 2px;
    text-transform: uppercase;
    font-weight: 600;
    border: 1px solid transparent;
    transition: var(--transition);
  }

  .btn-cta-principal {
    background: var(--gold);
    color: var(--black);
    border-color: var(--gold);
  }

  .btn-cta-principal:hover {
    background: transparent;
    color: var(--gold);
  }

  .btn-cta-zap {
    background: transparent;
    color: #25d366;
    border-color: #25d366;
  }

  .btn-cta-zap:hover {
    background: #25d366;
    color: #fff;
  }

  /* ─── RELACIONADOS ─── */
  .relacionados { margin-top: 80px; }

  .relacionados-titulo {
    font-family: 'Cormorant Garamond', serif;
    font-weight: 300;
    font-size: 30px;
    color: var(--black);
    margin-bottom: 28px;
    letter-spacing: 0.5px;
  }

  .relacionados-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 20px;
  }

  .relacionado-card {
    display: flex;
    flex-direction: column;
    background: #fff;
    border: 1px solid var(--cream);
    padding: 28px 24px;
    text-decoration: none;
    transition: var(--transition);
  }

  .relacionado-card:hover {
    border-color: var(--gold);
    transform: translateY(-3px);
    box-shadow: 0 20px 48px rgba(0,0,0,0.08);
  }

  .relacionado-card h3 {
    font-family: 'Cormorant Garamond', serif;
    font-size: 21px;
    font-weight: 400;
    line-height: 1.35;
    color: var(--black);
    margin-bottom: 20px;
    flex: 1;
  }

  .guia-tag {
    font-size: 10px;
    letter-spacing: 3px;
    text-transform: uppercase;
    color: var(--gold-dark);
    font-weight: 500;
    margin-bottom: 12px;
  }

  .guia-link {
    font-size: 11px;
    letter-spacing: 3px;
    text-transform: uppercase;
    font-weight: 600;
    color: var(--black);
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }

  .relacionado-card:hover .guia-link { color: var(--gold-dark); }
  .guia-link i { font-size: 11px; }

  @media (max-width: 768px) {
    .artigo { padding: 110px 20px 72px; }
    .prosa :global(h2) { font-size: 27px; margin-top: 44px; }
    .cta-compra { padding: 44px 24px; }
    .cta-botoes { flex-direction: column; }
    .relacionados-grid { grid-template-columns: 1fr; }
  }
</style>
